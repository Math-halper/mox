# Netlify / Cloudflare Pages: cross-origin isolation lets the WebAssembly engine
# use multiple threads. Everything Mox loads is served from this same origin, so
# requiring CORP for subresources is safe here.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff

/models/*
  Cache-Control: public, max-age=604800
/vendor/*
  Cache-Control: public, max-age=604800
