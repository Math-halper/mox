{
  "model": {
    "baseUrl": "http://127.0.0.1:11434/v1",
    "name": "",
    "apiKey": "local",
    "protocol": "auto",
    "temperature": 0.2,
    "maxTokens": 4096,
    "timeoutMs": 180000
  },
  "agent": {
    "maxSteps": 40,
    "maxToolOutputChars": 12000,
    "systemPromptExtra": ""
  },
  "policy": {
    "mode": "ask",
    "allowDangerous": false,
    "allowOutsideRoots": false,
    "rules": [
      { "tool": "shell", "match": "^npm (test|run (build|lint|typecheck))", "decision": "allow", "reason": "routine checks" },
      { "tool": "shell", "match": "\\bgit (push|reset --hard)\\b", "decision": "ask", "reason": "rewrites shared history" },
      { "tool": "shell", "match": "\\b(npm|pnpm|yarn) (add|install)\\b", "decision": "ask", "reason": "changes dependencies" },
      { "tool": "http_request", "match": "save_to", "decision": "ask" }
    ]
  },
  "sandbox": {
    "mode": "auto",
    "allowNetwork": true,
    "maskHome": true,
    "required": false
  },
  "trace": {
    "dir": ".mox/runs",
    "enabled": true
  },
  "memory": {
    "enabled": true,
    "path": ".mox/MEMORY.md"
  },
  "tools": {
    "shell": true,
    "files": true,
    "http": true,
    "browser": true,
    "memory": true
  },
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    }
  }
}
